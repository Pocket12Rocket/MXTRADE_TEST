# FastSport storefront. NEXT_PUBLIC_* values are compiled into the browser bundle, so they must
# never contain secrets. All secrets (email, PayFast and so on) live in FastSport_BackEnd.

# Backend API (FastSport_BackEnd) base URL, including the version, e.g. http://localhost:4000/v1
NEXT_PUBLIC_API_URL=
# This site's public URL, e.g. http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# Optional: logo path override and WhatsApp contact number
NEXT_PUBLIC_BRAND_LOGO=
NEXT_PUBLIC_WHATSAPP_NUMBER=
